@using KRAFT.Results.Contracts.Rankings
@using KRAFT.Results.Web.Client.Components.Cards

<EntityStatCard Leading="CardLeading.Rank(Entry.Rank)"
                Name="@Entry.Athlete"
                NameHref="@SlugSanitizer.SlugHref("/athletes/", Entry.AthleteSlug)"
                Pills="@_pills"
                MetaText="@_metaText"
                Label="IPF stig"
                Value="@_value"
                ValueHref="@_valueHref"
                ValueAriaLabel="@_valueAriaLabel"
                CssClass="card-spaced" />

@code {
    [Parameter, EditorRequired]
    public required RankingEntry Entry { get; set; }

    [Parameter]
    public string DisciplineLabel { get; set; } = string.Empty;

    private IReadOnlyList<MetaPill> _pills = [];
    private string _metaText = string.Empty;
    private string _value = string.Empty;
    private string? _valueHref;
    private string _valueAriaLabel = string.Empty;

    protected override void OnParametersSet()
    {
        _pills =
        [
            new MetaPill(PillKind.Neutral, $"{Entry.WeightCategory} kg"),
            new MetaPill(PillKind.Neutral, $"{Entry.BodyWeight:F2} kg"),
        ];

        _metaText = $"{Entry.Result:F1} {DisciplineLabel}";

        if (Entry.IpfPoints.HasValue)
        {
            string formatted = Entry.IpfPoints.Value.ToString("F2");
            _value = formatted;
            _valueHref = SlugSanitizer.SlugHref("/meets/", Entry.MeetSlug);
            _valueAriaLabel = $"{formatted} IPF stig, opna mót";
        }
        else
        {
            _value = "-";
            _valueHref = null;
            _valueAriaLabel = string.Empty;
        }
    }
}
