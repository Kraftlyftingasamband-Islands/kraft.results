@using KRAFT.Results.Contracts.TeamCompetition
@using Microsoft.Extensions.Configuration

@inject IConfiguration Configuration

<Card Compact="true" CssClass="@(_isFirst ? "card-spaced sc-card-first" : "card-spaced")">
<div class="sc-card">
    @if (_isMedal)
    {
        <div class="sc-rank @_rankClass" role="img" aria-label="@_rankAriaLabel">
            @_rankDisplay
        </div>
    }
    else
    {
        <div class="sc-rank @_rankClass">
            @_rankDisplay
        </div>
    }
    <div class="team-logo team-logo--sm">
        @if (Standing.LogoImageFilename is not null)
        {
            <img src="@($"{_teamLogoBaseUrl}/{Standing.LogoImageFilename}")"
                 alt="@($"{Standing.TeamName} logo")"
                 loading="lazy"
                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
            <div class="team-logo-placeholder" style="display:none">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 2.18l7 3.12v4.7c0 4.83-3.13 9.37-7 10.82-3.87-1.45-7-5.99-7-10.82V6.3l7-3.12z" />
                </svg>
            </div>
        }
        else
        {
            <div class="team-logo-placeholder">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 2.18l7 3.12v4.7c0 4.83-3.13 9.37-7 10.82-3.87-1.45-7-5.99-7-10.82V6.3l7-3.12z" />
                </svg>
            </div>
        }
    </div>
    <div class="sc-name-col">
        @if (!string.IsNullOrEmpty(Standing.TeamSlug))
        {
            <NavLink class="sc-team-abbr" href="@($"/teams/{Standing.TeamSlug}")">@Standing.TeamTitleShort</NavLink>
        }
        else
        {
            <span class="sc-team-abbr">@Standing.TeamTitleShort</span>
        }
        <span class="sc-team-name">@Standing.TeamName</span>
    </div>
    <div class="sc-points">
        <span class="sc-points-label">Stig</span>
        @Standing.TotalPoints
    </div>
</div>
</Card>

@code {
    [Parameter, EditorRequired]
    public TeamCompetitionStanding Standing { get; init; } = null!;

    private bool _isFirst;
    private bool _isMedal;
    private string _rankDisplay = string.Empty;
    private string _rankClass = string.Empty;
    private string _rankAriaLabel = string.Empty;
    private string _teamLogoBaseUrl = "";

    protected override void OnInitialized()
    {
        _teamLogoBaseUrl = Configuration["TeamLogoBaseUrl"] ?? "";
    }

    protected override void OnParametersSet()
    {
        _isFirst = Standing.Rank == 1;
        _isMedal = Standing.Rank is 1 or 2 or 3;
        _rankDisplay = Standing.Rank switch
        {
            1 => "\U0001f947",
            2 => "\U0001f948",
            3 => "\U0001f949",
            _ when Standing.Rank > 0 => Standing.Rank.ToString(),
            _ => "–",
        };
        _rankClass = _isMedal ? "rank-medal" : string.Empty;
        _rankAriaLabel = _isMedal ? $"{Standing.Rank}. sæti" : string.Empty;
    }
}
