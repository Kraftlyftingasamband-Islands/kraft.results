@using KRAFT.Results.Contracts.Records
@using KRAFT.Results.Web.Client.Components.Cards

<EntityStatCard Leading="@_leading"
                Name="@_name"
                NameHref="@_nameHref"
                Pills="@_pills"
                MetaText="@_metaText"
                Value="@_value"
                Unit="kg"
                ValueHref="@_valueHref"
                ValueAriaLabel="@_valueAriaLabel"
                CssClass="card-spaced" />

@code {
    [Parameter, EditorRequired]
    public required RecordEntry Record { get; set; }

    private CardLeading _leading = CardLeading.Badge(string.Empty);
    private string _name = string.Empty;
    private string? _nameHref;
    private IReadOnlyList<MetaPill> _pills = [];
    private string? _metaText;
    private string _value = string.Empty;
    private string? _valueHref;
    private string _valueAriaLabel = string.Empty;

    protected override void OnParametersSet()
    {
        if (Record.IsStandard)
        {
            _leading = CardLeading.Badge(Record.WeightCategory);
            _name = "Íslenski staðallinn";
            _nameHref = null;
            _pills = [];
            _metaText = null;
            _valueHref = null;
            _valueAriaLabel = string.Empty;
        }
        else
        {
            _leading = CardLeading.Badge(Record.WeightCategory, $"/records/{Record.Id}/history");
            _name = Record.Athlete ?? "-";
            _nameHref = Record.AthleteSlug is not null
                ? SlugSanitizer.SlugHref("/athletes/", Record.AthleteSlug)
                : null;

            List<MetaPill> pills = [];

            if (Record.BirthYear.HasValue)
            {
                pills.Add(new MetaPill(PillKind.Neutral, Record.BirthYear.Value.ToString()));
            }

            if (Record.BodyWeight.HasValue)
            {
                pills.Add(new MetaPill(PillKind.Neutral, $"{Record.BodyWeight.Value:F1} kg"));
            }

            _pills = pills;
            _metaText = Record.Date.ToString("dd.MM.yyyy");
            _valueHref = Record.MeetSlug is not null
                ? SlugSanitizer.SlugHref("/meets/", Record.MeetSlug)
                : null;
        }

        _value = Record.Weight.ToString("F1");

        _valueAriaLabel = _valueHref is not null
            ? $"{_value} kg, opna mót"
            : string.Empty;
    }
}
