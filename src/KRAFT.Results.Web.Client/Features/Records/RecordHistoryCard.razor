@using KRAFT.Results.Contracts.Records
@using KRAFT.Results.Web.Client.Components.Cards

@if (Entry.IsStandard)
{
    <EntityStatCard Name="Íslenski staðallinn"
                    MetaContent="@_standardMetaContent"
                    Value="@_value"
                    Unit="kg"
                    CssClass="card-spaced" />
}
else
{
    <EntityStatCard Name="@_name"
                    NameHref="@_nameHref"
                    Pills="@_pills"
                    MetaContent="@_metaContent"
                    Value="@_value"
                    Unit="kg"
                    CssClass="@_cssClass" />
}

@code {
    [Parameter, EditorRequired]
    public required RecordHistoryEntry Entry { get; set; }

    private string _name = string.Empty;
    private string? _nameHref;
    private IReadOnlyList<MetaPill> _pills = [];
    private RenderFragment? _metaContent;
    private RenderFragment? _standardMetaContent;
    private string _value = string.Empty;
    private string _cssClass = string.Empty;

    protected override void OnParametersSet()
    {
        _value = Entry.Weight.ToString("F1");

        if (Entry.IsStandard)
        {
            _standardMetaContent = BuildStandardMetaContent();
        }
        else
        {
            _name = Entry.Athlete ?? "-";
            _nameHref = Entry.AthleteSlug is not null
                ? SlugSanitizer.SlugHref("/athletes/", Entry.AthleteSlug)
                : null;

            List<MetaPill> pills = [];
            if (Entry.BodyWeight.HasValue)
            {
                pills.Add(new MetaPill(PillKind.Neutral, $"{Entry.BodyWeight.Value:F1} kg"));
            }

            _pills = pills;
            _cssClass = Entry.IsCurrent ? "card-spaced rhc-current" : "card-spaced";
            _metaContent = BuildMetaContent();
        }
    }

    private RenderFragment BuildMetaContent() => __builder =>
    {
        if (Entry.IsCurrent)
        {
            <span class="card-status card-status--active">Núverandi met</span>
        }

        <span>@Entry.Date.ToString("dd.MM.yyyy")</span>

        @if (Entry.MeetSlug is not null && Entry.Meet is not null)
        {
            <NavLink href="@SlugSanitizer.SlugHref("/meets/", Entry.MeetSlug)">@Entry.Meet</NavLink>
        }
        else if (Entry.Meet is not null)
        {
            <span>@Entry.Meet</span>
        }

        @if (Entry.Delta.HasValue)
        {
            <span class="rhc-delta">▲ +@Entry.Delta.Value.ToString("F1")</span>
        }
    };

    private RenderFragment BuildStandardMetaContent() => __builder =>
    {
        if (Entry.IsCurrent)
        {
            <span class="card-status card-status--active">Núverandi met</span>
        }

        <span>@Entry.Date.ToString("dd.MM.yyyy")</span>
    };
}
